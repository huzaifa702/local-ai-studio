# ===================================================
# LocalAI Studio - Environment Configuration (.env)
# ===================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Authentication & Security (Generate a secure random string for production)
JWT_SECRET=local-ai-studio-secret-jwt-key-2026

# Local Ollama Daemon URL
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Google OAuth Client ID (For 1-Click Google Sign-In)
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Web Search API Keys (Optional - Free DuckDuckGo search is active by default)
# Tavily API: https://tavily.com
TAVILY_API_KEY=

# Cloud AI Provider API Keys (Optional - for hybrid cloud inference alongside local Ollama)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
